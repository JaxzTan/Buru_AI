# Copy to .env. Never commit .env (secrets policy, docs/TRD.md §7).
BURU_ENV=local
BURU_HTTP_ADDR=:8080
BURU_MYSQL_DSN=buru:buru@tcp(localhost:3307)/buru?parseTime=true
BURU_REDIS_ADDR=localhost:6379
BURU_TEMPORAL_HOSTPORT=localhost:7233
BURU_TEMPORAL_NAMESPACE=default
BURU_TEMPORAL_TASK_QUEUE=buru-main

