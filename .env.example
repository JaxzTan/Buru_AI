# Copy to .env (git-ignored) and fill in. The Makefile exports these to `make run` / `make tglogin`.

# ─── Core ───
SOCKABUS_ENV=local
# demo = in-memory pitch data + scripted scammers (default). live = real Telegram honeypot on PostgreSQL.
SOCKABUS_MODE=live
SOCKABUS_HTTP_ADDR=:8080
SOCKABUS_POSTGRES_URL=postgres://buru:buru@localhost:5432/buru?sslmode=disable
SOCKABUS_REDIS_ADDR=localhost:6379
SOCKABUS_TEMPORAL_HOSTPORT=localhost:7233
SOCKABUS_TEMPORAL_NAMESPACE=default
SOCKABUS_TEMPORAL_TASK_QUEUE=sockabus-main

# ─── Live mode secrets (make keys prints fresh values) ───
# Bearer token for /internal/* and /v1/lookup until operator login (email + TOTP) exists.
SOCKABUS_OPERATOR_TOKEN=
# operators.id recorded on operator actions (db/seed creates operator 1).
SOCKABUS_OPERATOR_ID=1
# Base64 32-byte key that encrypts message bodies at rest. Losing it makes stored messages unreadable.
SOCKABUS_MESSAGE_KEY=

# ─── LLM ───
# gemini (default) | anthropic | none (none = personas reply with playbook example lines only)
SOCKABUS_LLM_PROVIDER=gemini
GEMINI_API_KEY=
SOCKABUS_PERSONA_MODEL=gemini-3.8-flash
SOCKABUS_EXTRACT_MODEL=gemini-3.8-flash
# Gemini thinking level for persona replies: low | medium | high
SOCKABUS_PERSONA_THINKING=low
# Max wait for one persona reply from the LLM before using the playbook's example line instead.
SOCKABUS_LLM_TIMEOUT=45s
# Per attempt: a call that stalls longer than this is retried (Gemini sometimes never answers a request).
SOCKABUS_LLM_TRY_TIMEOUT=14s
# Only used when SOCKABUS_LLM_PROVIDER=anthropic (TRD default)
ANTHROPIC_API_KEY=

# ─── Telegram (https://my.telegram.org → API development tools) ───
SOCKABUS_TG_APP_ID=
SOCKABUS_TG_APP_HASH=
SOCKABUS_TG_SESSION_DIR=.secrets/telegram
# Development only: 1-3 uses Telegram's TEST network (fake numbers 99966XYYYY, code = X repeated).
# Leave empty for real Telegram. Test accounts cannot talk to real Telegram users.
SOCKABUS_TG_TEST_DC=
# While testing, only reply to these senders (comma-separated @usernames or tg:<user id>). Empty = everyone.
SOCKABUS_TG_ONLY_FROM=
# What the honeypot account shows under Settings → Devices. Match the persona's phone.
SOCKABUS_TG_DEVICE_MODEL=Samsung SM-A145F
SOCKABUS_TG_SYSTEM_VERSION=Android 14

# Local chat simulator (make sim): on by default when SOCKABUS_ENV=local; set 0 to turn off, 1 to force on.
SOCKABUS_SIM=

# ─── Human-like timing (FR-3: replies never come sooner than 10 s, whatever is set here) ───
SOCKABUS_REPLY_READ_MIN=12s
SOCKABUS_REPLY_READ_MAX=45s
SOCKABUS_TYPING_CPS=3.5
SOCKABUS_INACTIVITY=72h

# ─── Production (VPS only, used by docker-compose.prod.yml and make backup) ───
# Domain Caddy serves and gets the HTTPS certificate for. Its DNS A record must point at the VPS.
SOCKABUS_DOMAIN=
# PostgreSQL password for the buru user (openssl rand -hex 24). Leave empty locally (defaults to buru).
POSTGRES_PASSWORD=
# rclone destination for nightly dumps, e.g. r2:buru-backups. Empty = dumps stay on the server.
BACKUP_REMOTE=

# ─── Demo mode only ───
SOCKABUS_SIMULATE=1
# App database login (buru_api, member of buru_app: no UPDATE/DELETE on audit tables).
# Local Docker:
SOCKABUS_POSTGRES_URL=postgres://buru:buru@localhost:5432/buru?sslmode=disable
# Supabase:
# SOCKABUS_POSTGRES_URL="postgresql://buru_api:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Supabase owner login (postgres), used only for migrations. Never give this to the app.
DATABASE_URL=
SUPABASE_PASSWORD=

# Supabase project (dashboard reference only; the web app talks to the Go API, not Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Console (web/): the /api proxy and /api/demo/lookup add the operator token server-side; it never reaches the browser.
# SOCKABUS_API_URL=http://localhost:8080
# Lookup key for the bank simulator; falls back to SOCKABUS_OPERATOR_TOKEN until per-customer keys exist (FR-13).
# SOCKABUS_LOOKUP_TOKEN=
# Console: true = sample data in the browser, no Go API needed (offline demo / UI work).
# NEXT_PUBLIC_USE_SAMPLE_DATA=false
# Console: how long Verify/Reject waits before saving, so Undo can cancel it (frontend spec §4.5). Use 0 in tests.
# NEXT_PUBLIC_UNDO_MS=6000

# Added in later milestones
# ANTHROPIC_API_KEY=
# TRONGRID_API_KEY=
# ETHERSCAN_API_KEY=
