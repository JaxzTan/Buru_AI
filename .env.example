# Copy to .env and fill in. Never commit .env (secrets policy, docs/TRD.md §7).
BURU_ENV=local
BURU_HTTP_ADDR=:8080
BURU_REDIS_ADDR=localhost:6379
BURU_TEMPORAL_HOSTPORT=localhost:7233
BURU_TEMPORAL_NAMESPACE=default
BURU_TEMPORAL_TASK_QUEUE=buru-main

# App database login (buru_api, member of buru_app: no UPDATE/DELETE on audit tables).
# Local Docker:
BURU_POSTGRES_URL=postgres://buru:buru@localhost:5432/buru?sslmode=disable
# Supabase:
# BURU_POSTGRES_URL="postgresql://buru_api:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require"

# Supabase owner login (postgres), used only for migrations. Never give this to the app.
DATABASE_URL=
SUPABASE_PASSWORD=

# Supabase project (dashboard reference only; the web app talks to the Go API, not Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Added in later milestones
# ANTHROPIC_API_KEY=
# TRONGRID_API_KEY=
# ETHERSCAN_API_KEY=
