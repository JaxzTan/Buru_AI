# Reverse proxy for prod (docker-compose.prod.yml). Caddy gets the HTTPS certificate for SOCKABUS_DOMAIN itself.
{$SOCKABUS_DOMAIN} {
	encode zstd gzip

	# Bank clients and uptime checks reach the Go API directly.
	@api path /v1/* /healthz /readyz
	handle @api {
		reverse_proxy app:8080
	}

	# Dashboard; it proxies /api/* to the Go API itself.
	handle {
		reverse_proxy web:3000
	}
}
